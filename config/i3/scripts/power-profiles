#!/usr/bin/env bash
# Cambia el modo de TLP en caliente.
# El instalador deja NOPASSWD en /etc/sudoers.d/tlp-modes para estos tres subcomandos.

ROFI_OPTIONS=(-theme "${HOME}/.config/rofi/power-profiles.rasi")

choice=$(printf '%s\n' "Automático" "Rendimiento" "Equilibrado" "Ahorro" "Cancelar" | rofi -dmenu -i -p "TLP" "${ROFI_OPTIONS[@]}")

case "$choice" in
	Automático) sudo -n tlp start ;;
	Rendimiento) sudo -n tlp performance ;;
	Equilibrado) sudo -n tlp balanced ;;
	Ahorro) sudo -n tlp power-saver ;;
	*) exit 0 ;;
esac
